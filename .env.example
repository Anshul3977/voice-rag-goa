# Speech-to-text (pick ElevenLabs per task requirement)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Generation LLM (Anthropic used by default in src/generation.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: swap generation.py to use OpenAI instead
OPENAI_API_KEY=your_openai_api_key_here

# Paths (defaults are fine, override if needed)
DATA_DIR=./data/store
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GENERATION_MODEL=claude-haiku-4-5-20251001
HF_TOKEN=your_huggingface_token_here
