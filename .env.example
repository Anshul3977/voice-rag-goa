# Copy to .env for local runs. Never commit .env.
# On Render this key is a service env var with sync: false, set in the Dashboard.

# Required for generated answers and microphone transcription.
# Leave blank to run in retrieval-only mode (cited passages, no LLM call).
GROQ_API_KEY=

# groq (default) or openai. OpenAI-compatible base URL overrides follow.
LLM_PROVIDER=groq
# GENERATION_MODEL=llama-3.3-70b-versatile
# STT_MODEL=whisper-large-v3-turbo

# Only used when LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=

# Committed chunk files. BM25 is built in memory from these at startup.
DATA_DIR=./data/store
